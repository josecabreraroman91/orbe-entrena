{
  "rules": {
    ".read": false,
    ".write": false,

    "miembros": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "root.child('superadmin').child(auth.uid).val() === true",
        "$aid": {
          ".write": "root.child('superadmin/'+auth.uid).val() === true || ($uid === auth.uid && !data.exists() && !root.child('academias/'+$aid).exists() && newData.child('rol').val() === 'admin')",
          "rol": { ".validate": "newData.val() === 'admin' || newData.val() === 'profe'" }
        }
      }
    },

    "superadmin": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": false
      }
    },

    "academias": {
      "$aid": {

        ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' || root.child('superadmin/'+auth.uid).val() === true)",

        "suscripcion": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid).exists() || root.child('superadmin/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' || root.child('superadmin/'+auth.uid).val() === true)",
          "plan":    { ".validate": "newData.val() === 'prueba' || newData.val() === 'vencido' || (newData.val() === 'activo' && root.child('superadmin/'+auth.uid).val() === true)" },
          "vence":   { ".validate": "newData.isString() && newData.val().length === 10 && (!data.exists() || root.child('superadmin/'+auth.uid).val() === true)" },
          "venceMs": { ".validate": "newData.isNumber() && (!data.exists() || root.child('superadmin/'+auth.uid).val() === true)" },
          "$otro":   { ".validate": false }
        },

        "config": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid).exists() || root.child('superadmin/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' || root.child('superadmin/'+auth.uid).val() === true || !root.child('academias/'+$aid).exists())",
          "nombre":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "moneda":   { ".validate": "newData.isString() && newData.val().length <= 5" },
          "sedes":    { "$i": { ".validate": "newData.isString() && newData.val().length <= 40" } },
          "modulos":  { "$m": { ".validate": "newData.isBoolean()" } },
          "$otro":    { ".validate": false }
        },

        "alumnos": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid).exists() || root.child('superadmin/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('superadmin/'+auth.uid).val() === true || (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' && (root.child('academias/'+$aid+'/suscripcion/plan').val() === 'activo' || !root.child('academias/'+$aid+'/suscripcion').exists() || now <= root.child('academias/'+$aid+'/suscripcion/venceMs').val())))",
          ".indexOn": ["nombreNorm", "sede"],
          "$id": {
            ".validate": "!newData.exists() || newData.hasChildren(['nombre','nombreNorm','ts'])",
            "nombre":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
            "nombreNorm": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "tel":        { ".validate": "newData.isString() && newData.val().length <= 25" },
            "sede":       { ".validate": "newData.isString() && newData.val().length <= 40" },
            "nivel":      { ".validate": "newData.isString() && newData.val().length <= 20" },
            "cat":        { ".validate": "newData.isString() && newData.val().length <= 20" },
            "lado":       { ".validate": "newData.val() === '' || newData.val() === 'DRV' || newData.val() === 'REV' || newData.val() === 'AMB'" },
            "tipo":       { ".validate": "newData.val() === '' || newData.val() === 'G' || newData.val() === 'D' || newData.val() === 'IND'" },
            "precio":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "nomHor":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "nomWpp":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "activo":     { ".validate": "newData.isBoolean()" },
            "nota":       { ".validate": "newData.isString() && newData.val().length <= 300" },
            "ts":         { ".validate": "newData.isNumber()" },
            "por":        { ".validate": "newData.isString() && newData.val() === auth.token.email" },
            "$otro":      { ".validate": false }
          }
        },

        "profesores": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid).exists() || root.child('superadmin/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('superadmin/'+auth.uid).val() === true || (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' && (root.child('academias/'+$aid+'/suscripcion/plan').val() === 'activo' || !root.child('academias/'+$aid+'/suscripcion').exists() || now <= root.child('academias/'+$aid+'/suscripcion/venceMs').val())))"
        },

        "calendario": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid).exists() || root.child('superadmin/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('superadmin/'+auth.uid).val() === true || (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' && (root.child('academias/'+$aid+'/suscripcion/plan').val() === 'activo' || !root.child('academias/'+$aid+'/suscripcion').exists() || now <= root.child('academias/'+$aid+'/suscripcion/venceMs').val())))"
        },

        "asistencia": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid).exists() || root.child('superadmin/'+auth.uid).val() === true)",
          "$fecha": {
            "$id": {
              ".write": "auth != null && (root.child('superadmin/'+auth.uid).val() === true || (root.child('miembros/'+auth.uid+'/'+$aid).exists() && (root.child('academias/'+$aid+'/suscripcion/plan').val() === 'activo' || !root.child('academias/'+$aid+'/suscripcion').exists() || now <= root.child('academias/'+$aid+'/suscripcion/venceMs').val())))",
              "estado": { ".validate": "newData.val() === 'presente' || newData.val() === 'ausente'" },
              "ts":     { ".validate": "newData.isNumber()" },
              "por":    { ".validate": "newData.isString() && newData.val() === auth.token.email" },
              "$otro":  { ".validate": false }
            }
          }
        },

        "cobros": {
          ".read": "auth != null && (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' || root.child('superadmin/'+auth.uid).val() === true)",
          ".write": "auth != null && (root.child('superadmin/'+auth.uid).val() === true || (root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin' && (root.child('academias/'+$aid+'/suscripcion/plan').val() === 'activo' || !root.child('academias/'+$aid+'/suscripcion').exists() || now <= root.child('academias/'+$aid+'/suscripcion/venceMs').val())))"
        },

        "log": {
          ".read": "auth != null && root.child('miembros/'+auth.uid+'/'+$aid+'/rol').val() === 'admin'",
          "$id": {
            ".write": "auth != null && root.child('miembros/'+auth.uid+'/'+$aid).exists() && !data.exists() && newData.exists()"
          }
        }
      }
    }
  }
}
